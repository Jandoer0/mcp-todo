[Unit]
Description=OmniTask MCP Todo Service
After=network.target

[Container]
Image=ghcr.io/jandoer0/mcp-todo:latest
ContainerName=mcp-todo
# AutoUpdate=registry

Network=services-net.network

# Port 8000 for API and MCP SSE
PublishPort=8000:8000

# Volumes for persistence
Volume=/mnt/library/config/mcp-todo/data:/app/data:U

# Environment
Environment=DATABASE_URL=sqlite:///./data/tasks.db
Environment=SECRET_KEY=change-this-to-a-random-secure-string-in-production
# Bootstrap: this account is promoted to admin on startup if no admin exists yet.
Environment=ADMIN_USERNAME=Veggie

[Service]
Restart=always

[Install]
WantedBy=default.target
